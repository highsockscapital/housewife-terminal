<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer sidebar: new-session header, active session list, glibc file explorer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/housewife_window_background"
    android:orientation="vertical"
    android:padding="12dp">

    <Button
        android:id="@+id/btn_new_session"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_new_session"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:text="+ New Session"
        android:textColor="@color/housewife_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="SESSIONS"
        android:textColor="@color/housewife_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/housewife_window_background"
        android:clipToPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="GLIBC FILESYSTEM"
        android:textColor="@color/housewife_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_file_tree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/housewife_window_background"
        android:clipToPadding="false" />
</LinearLayout>
