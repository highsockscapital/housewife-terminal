<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 2D markdown preview sheet: header (title, edit action, close) + scrollable rendered content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/markdown_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/housewife_window_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/markdown_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/housewife_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <Button
            android:id="@+id/markdown_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_status_chip"
            android:elevation="0dp"
            android:minHeight="32dp"
            android:paddingHorizontal="12dp"
            android:stateListAnimator="@null"
            android:text="Edit in Shell"
            android:textAllCaps="false"
            android:textColor="@color/housewife_text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/markdown_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_close_button"
            android:contentDescription="Close preview"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/housewife_text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/markdown_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_markdown_content"
            android:padding="12dp"
            android:textColor="@color/housewife_text_primary"
            android:textSize="14sp" />
    </ScrollView>
</LinearLayout>
