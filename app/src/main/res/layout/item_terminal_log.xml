<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated flat terminal output card: raw stdout/stderr stream, never a chat bubble. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/chat_terminal_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_terminal_card"
        android:lineSpacingExtra="4sp"
        android:padding="12dp"
        android:textColor="@color/housewife_text_primary"
        android:textSize="13sp"
        android:typeface="monospace" />
</LinearLayout>
