<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 2D circular close button: #FFE8CF fill, 1dp #161610 border (circle at 32dp). No elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/housewife_input_background" />
    <stroke
        android:width="1dp"
        android:color="@color/housewife_stroke_border" />
    <size
        android:width="32dp"
        android:height="32dp" />
</shape>
