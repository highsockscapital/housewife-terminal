<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 2D assistant bubble: #FFFFFF fill, 1dp #E0E0D6 border, 16dp radius. No elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/housewife_assistant_background" />
    <stroke
        android:width="1dp"
        android:color="@color/housewife_stroke_border_light" />
    <corners android:radius="16dp" />
</shape>
