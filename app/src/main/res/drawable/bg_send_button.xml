<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 2D circular send button: #FF9E43 fill, 1dp #161610 border, 24dp radius (circle at 48dp). No elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/housewife_primary_accent" />
    <stroke
        android:width="1dp"
        android:color="@color/housewife_stroke_border" />
    <size
        android:width="48dp"
        android:height="48dp" />
</shape>
