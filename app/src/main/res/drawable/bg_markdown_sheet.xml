<?xml version="1.0" encoding="utf-8"?>
<!-- Flat 2D bottom-sheet background: #F6F3E7 fill, 1.5dp #161610 border, 16dp top corners. No elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/housewife_window_background" />
    <stroke
        android:width="1.5dp"
        android:color="@color/housewife_stroke_border" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
